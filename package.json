{
  "name": "agon",
  "version": "0.0.0",
  "description": "Agon, a deterministic Ports & Adapters simulation engine where players and AI agents contest under one rule set.",
  "scripts": {
    "test": "node scripts/testing/run-vitest.mjs",
    "test:recipe-adoption": "node scripts/testing/check-test-recipe-adoption.mjs",
    "test:vitest": "node scripts/testing/run-vitest.mjs",
    "test:coverage:core-ts": "node scripts/testing/run-core-ts-coverage.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:report": "node scripts/testing/typecheck-report.mjs",
    "config-sweep": "node scripts/testing/run-configuration-permutation-sweep.mjs",
    "logic-sweep": "node scripts/testing/run-logic-sweep.mjs",
    "logic-sweep:dry-run": "node scripts/testing/run-logic-sweep.mjs --dry-run",
    "sim:sweep": "node scripts/testing/run-simulation-sweep.mjs",
    "config-sweep:dry-run": "node scripts/testing/run-configuration-permutation-sweep.mjs --dry-run",
    "demo:cli": "bash scripts/demo-cli.sh",
    "play:ascii": "node packages/ui-ascii/src/cli.mjs",
    "play:web": "node packages/ui-ascii/src/cli.mjs --web",
    "levels:ascii": "node scripts/ui-ascii/generate-levels.mjs",
    "mcp:serve": "node packages/adapters-cli/src/mcp/server.mjs",
    "build:engine": "node scripts/build/engine-bundle.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
